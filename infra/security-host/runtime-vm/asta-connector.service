[Unit]
Description=ASTA exchange-demo connector (FUTURE, M3-B; not authorised yet)
After=network.target asta-vault.socket
Requires=asta-vault.socket

[Service]
Type=simple
ExecStart=/opt/asta/venv/bin/python -m asta.connectors.demo
User=asta-connector
Group=asta-connector
Environment=HTTPS_PROXY=http://10.77.0.1:3128
# only the proxy (10.77.0.1) is reachable; everything else is refused by the unit as well as by nftables
IPAddressDeny=any
IPAddressAllow=10.77.0.1/32
IPAddressAllow=127.0.0.1/32
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitCORE=0
Restart=on-failure
