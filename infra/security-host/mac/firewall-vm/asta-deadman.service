[Unit]
Description=ASTA dead-man's-switch heartbeat (firewall VM)
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/asta/asta-deadman.sh
EnvironmentFile=-/etc/asta-egress/deadman.env
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
