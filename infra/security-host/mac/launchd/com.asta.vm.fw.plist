<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.asta.vm.fw</string>
  <key>UserName</key><string>_astavm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/usr/local/libexec/asta/qemu-vms.sh</string>
    <string>run</string>
    <string>fw</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DRY_RUN</key><string>0</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>WorkingDirectory</key><string>/var/lib/asta-vm</string>
  <key>StandardOutPath</key><string>/var/log/asta/com.asta.vm.fw.log</string>
  <key>StandardErrorPath</key><string>/var/log/asta/com.asta.vm.fw.err</string>
</dict>
</plist>
