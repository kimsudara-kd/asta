[Unit]
Description=ASTA paper supervisor (health samples, pre-resume reconciliation gate, restart of the service)
After=postgresql.service nftables.service
Requires=postgresql.service

[Service]
Type=simple
User=asta-app
Group=asta-app
WorkingDirectory=/var/lib/asta
EnvironmentFile=/etc/asta/asta.env
Environment=HTTPS_PROXY=http://10.77.1.1:3128 HTTP_PROXY=http://10.77.1.1:3128 NO_PROXY=127.0.0.1,localhost
# the unchanged supervisor logic with /proc-based helpers; systemd replaces the Windows keep-alive task
ExecStart=/opt/asta/venv/bin/python /opt/asta/src/scripts/paper_supervisor_posix.py
ReadWritePaths=/var/lib/asta
IPAddressDeny=any
IPAddressAllow=10.77.1.1/32
IPAddressAllow=127.0.0.1/32
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitCORE=0
Restart=always
RestartSec=3
