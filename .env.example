# Copy to .env (git-ignored). NEVER put exchange API keys here: the app refuses to start if
# any BINANCE_*/OKX_* *_API_KEY/_SECRET/_PASSPHRASE variable exists (ADR-0002).
ASTA_DATABASE_URL=postgresql+pg8000://asta:asta_dev_only@127.0.0.1:5640/asta
ASTA_SECRET_KEY=change-me-long-random-string   # encrypts TOTP secrets at rest
ASTA_API_PORT=4640
# Comma list of venues to run as labelled FIXTURE data (e.g. OKX when unreachable)
ASTA_FIXTURE_VENUES=
