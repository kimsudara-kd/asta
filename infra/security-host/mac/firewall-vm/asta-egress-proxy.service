[Unit]
Description=ASTA egress proxy (CONNECT allowlist; infra/egress/proxy.py) - Mac mini ARM64 deployment
After=nftables.service asta-allowlist-refresh.service
Requires=nftables.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/asta-egress/proxy.py
# listens on both private links; nftables accepts only app0/cred0 sources, never up0
Environment=ASTA_EGRESS_PROFILE=runtime EGRESS_LISTEN_HOST=0.0.0.0 EGRESS_LISTEN_PORT=3128
Environment=EGRESS_ALLOWLIST=/etc/asta-egress/allowlist.json
BindReadOnlyPaths=/etc/asta-egress/hosts:/etc/hosts /etc/asta-egress/empty-resolv.conf:/etc/resolv.conf
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.77.1.0/30
IPAddressAllow=10.77.2.0/30
IPAddressAllow=0.0.0.0/0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitCORE=0
Restart=always
RestartSec=2
