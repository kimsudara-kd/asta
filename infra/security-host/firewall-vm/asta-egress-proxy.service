[Unit]
Description=ASTA egress proxy (CONNECT allowlist; infra/egress/proxy.py)
After=nftables.service asta-allowlist-refresh.service
Requires=nftables.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/asta-egress/proxy.py
Environment=ASTA_EGRESS_PROFILE=runtime EGRESS_LISTEN_HOST=10.77.0.1 EGRESS_LISTEN_PORT=3128
Environment=EGRESS_ALLOWLIST=/etc/asta-egress/allowlist.json
BindReadOnlyPaths=/etc/asta-egress/hosts:/etc/hosts /etc/asta-egress/empty-resolv.conf:/etc/resolv.conf
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# defence in depth next to nftables: the unit itself may only talk to the protected net and the Internet
IPAddressDeny=any
IPAddressAllow=10.77.0.0/24
IPAddressAllow=0.0.0.0/0
Restart=always
RestartSec=2
