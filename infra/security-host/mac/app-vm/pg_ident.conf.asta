# map the OS service user to the database role (no password exists)
asta   asta-app   asta
bridge    asta-bridge    asta_bridge
orders    asta-orders    asta_orders
monitor   asta-monitor   asta_monitor
release   /^asta-release-(.+)$   rel_\1   # OS login asta-release-<name> -> DB role rel_<name>: one identity per human, never a service
